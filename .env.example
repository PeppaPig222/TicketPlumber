# ============================================================
# 小哈工单智能诊断助手 — 环境变量配置示例
# 复制本文件为 .env 后填入真实值
# ============================================================

# --- LLM 配置 ---
DIAG_LLM_API_KEY=your_api_key_here
DIAG_LLM_MODEL_NAME=doubao-pro-32k
DIAG_LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DIAG_LLM_TEMPERATURE=0.7
DIAG_LLM_MAX_TOKENS=8192

# --- 系统配置 ---
# 运行环境：development / testing / production
DIAG_SYS_ENV=development
DIAG_SYS_LOG_LEVEL=INFO
DIAG_SYS_ENABLE_LLM=true
DIAG_SYS_MAX_RETRIES=3
DIAG_SYS_TIMEOUT=60

# --- RAG 知识库配置 ---
DIAG_RAG_EMBEDDING_MODEL=data/models/bge-small-zh-v1.5
DIAG_RAG_ENABLE_INTENTION_FALLBACK=true
DIAG_RAG_ENABLE_RESOLUTION_EVIDENCE=true
DIAG_RAG_MIN_SIMILARITY_THRESHOLD=0.55
# Milvus 服务地址（如 http://milvus:19530）；留空则用本地 Milvus Lite
DIAG_RAG_MILVUS_URI=
# 语义路由：规则未命中时用 embedding 做场景分类（双阈值 + margin）
DIAG_RAG_ENABLE_SEMANTIC_ROUTER=true
DIAG_RAG_SEMANTIC_ROUTER_HIGH_THRESHOLD=0.6
DIAG_RAG_SEMANTIC_ROUTER_LOW_THRESHOLD=0.45
DIAG_RAG_SEMANTIC_ROUTER_MARGIN=0.08

# --- 韧性/重试/熔断配置 ---
DIAG_RES_MAX_RETRIES=3
DIAG_RES_RETRY_BASE_DELAY_SEC=1.0
DIAG_RES_RETRY_MAX_DELAY_SEC=30.0
DIAG_RES_CIRCUIT_FAILURE_THRESHOLD=5
DIAG_RES_CIRCUIT_RECOVERY_TIMEOUT_SEC=60.0
DIAG_RES_CIRCUIT_HALF_OPEN_SUCCESSES=2
DIAG_RES_HEALTH_CHECK_TIMEOUT_SEC=10.0
DIAG_RES_SKILL_TIMEOUT_SEC=5.0

# --- 持久化存储配置（trace / 诊断结果 / 反馈） ---
DIAG_STORE_BACKEND=sqlite
DIAG_STORE_DB_PATH=data/diagbot.db
DIAG_STORE_ENABLE_PERSISTENT_TRACE=true
DIAG_STORE_ENABLE_FEEDBACK=true

# --- 记忆后端 / Redis 缓存层 ---
DIAG_MEM_BACKEND=local
DIAG_MEM_REDIS_HOST=localhost
DIAG_MEM_REDIS_PORT=6379
DIAG_MEM_REDIS_DB=0
DIAG_MEM_REDIS_PASSWORD=
# Redis 缓存层：RAG/工具结果缓存，未安装 redis 或连接失败时自动降级内存
DIAG_MEM_REDIS_CACHE_ENABLED=false
DIAG_MEM_REDIS_CACHE_TTL_SECONDS=300

# --- PostgreSQL 长期记忆（postgres_enabled=true 时使用，连不上自动降级 File） ---
DIAG_MEM_POSTGRES_ENABLED=false
DIAG_MEM_POSTGRES_HOST=localhost
DIAG_MEM_POSTGRES_PORT=5432
DIAG_MEM_POSTGRES_USER=postgres
DIAG_MEM_POSTGRES_PASSWORD=postgres
DIAG_MEM_POSTGRES_DB=diagbot
